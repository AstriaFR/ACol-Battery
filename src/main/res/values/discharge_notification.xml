<resources>
    <style name="DischargeNoticeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8dp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1px</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Notification.Title</item>
    </style>

    <style name="DischargeNoticeText.Last">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_gravity">fill_horizontal|center_vertical</item>
    </style>
</resources>
