<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:columnCount="3"
    android:rowCount="2">

    <TextView style="@style/DischargeNoticeText" android:id="@+id/record_notice_top_start"
        android:layout_row="0" android:layout_column="0" />
    <TextView style="@style/DischargeNoticeText" android:id="@+id/record_notice_top_center"
        android:layout_row="0" android:layout_column="1" />
    <TextView style="@style/DischargeNoticeText.Last" android:id="@+id/record_notice_top_end"
        android:layout_row="0" android:layout_column="2" />

    <TextView style="@style/DischargeNoticeText" android:id="@+id/record_notice_bottom_start"
        android:layout_row="1" android:layout_column="0" />
    <TextView style="@style/DischargeNoticeText" android:id="@+id/record_notice_bottom_center"
        android:layout_row="1" android:layout_column="1" />
    <TextView style="@style/DischargeNoticeText.Last" android:id="@+id/record_notice_bottom_end"
        android:layout_row="1" android:layout_column="2" />
</GridLayout>
