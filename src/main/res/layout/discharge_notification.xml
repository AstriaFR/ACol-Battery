<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:columnCount="3"
    android:rowCount="2">

    <TextView style="@style/DischargeNoticeText" android:id="@+id/discharge_capacity"
        android:layout_row="0" android:layout_column="0" />
    <TextView style="@style/DischargeNoticeText" android:id="@+id/discharge_energy"
        android:layout_row="0" android:layout_column="1" />
    <TextView style="@style/DischargeNoticeText.Last" android:id="@+id/discharge_duration"
        android:layout_row="0" android:layout_column="2" />

    <TextView style="@style/DischargeNoticeText" android:id="@+id/discharge_power"
        android:layout_row="1" android:layout_column="0" />
    <TextView style="@style/DischargeNoticeText" android:id="@+id/discharge_voltage"
        android:layout_row="1" android:layout_column="1" />
    <TextView style="@style/DischargeNoticeText.Last" android:id="@+id/discharge_temperature"
        android:layout_row="1" android:layout_column="2" />
</GridLayout>
